# Normalize line endings: LF in the repository, LF on checkout (cross-platform stable).
# This removes the "LF will be replaced by CRLF" warnings on Windows and keeps hashes
# deterministic across contributors.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Preserve the exact official HL7 R4 source bytes used by the MRL-0809 compiler.
specs/mesc-experiment-0/fhir-r4/patient.profile.json -text -eol
specs/mesc-experiment-0/fhir-r4/address.profile.json -text -eol
*.cff   text eol=lf
*.txt   text eol=lf
LICENSE text eol=lf

# Binary assets (never normalize)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.gz   binary
*.zip  binary
