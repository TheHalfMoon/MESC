{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medscale.dev/schemas/mesc/mrl-project-state-v1.schema.json",
  "title": "MESC MRL Project State Projection V1",
  "description": "Non-authoritative deterministic projection of canonical MRL task state. This document cannot grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_kind",
    "can_authorize",
    "repository",
    "sources",
    "source_set_sha256",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "MRL-PROJECT-STATE-V1"
    },
    "projection_kind": {
      "const": "DERIVED_NON_AUTHORITATIVE"
    },
    "can_authorize": {
      "const": false
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha"],
      "properties": {
        "commit_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "tree_sha": {
          "$ref": "#/$defs/gitSha"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceBinding"
      }
    },
    "source_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskState"
      }
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_blob_sha", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "git_blob_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "taskState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "state", "dependencies", "evidence_refs"],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^MRL-[0-9]{4}$"
        },
        "state": {
          "enum": [
            "PLANNED",
            "ELIGIBLE",
            "IN_PROGRESS",
            "BLOCKED",
            "QUALIFYING",
            "CLOSED_CANONICAL"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^MRL-[0-9]{4}$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
